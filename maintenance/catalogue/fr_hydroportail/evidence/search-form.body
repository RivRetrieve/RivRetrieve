        </label>
        <input type="text" id="hydro_entities_search_label_value" name="hydro_entities_search[label][value]" class="form-control form-control" /></div>
    
                        <div class="mt-n3 text-secondary f-size-85rem">            <div class="form-group"><div class="form-check">        <input type="checkbox" id="hydro_entities_search_label_strict" name="hydro_entities_search[label][strict]" class="form-check-input" value="1" />
        <label class="form-check-label" for="hydro_entities_search_label_strict">Orthographe stricte</label></div></div>
    </div>
                    </div>
