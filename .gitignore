# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment files
.env
*.env

# OS
.DS_Store
Thumbs.db

# Jupyter notebooks
*.ipynb

# Scratchpad (keep folder, ignore contents)
scratchpad/*
!scratchpad/.gitkeep

# PCE planning artifacts: keep only the audit record of a delivered vision.
# The immutable *.executions.json gate sidecars are raw evidence, large, and
# regenerable from the verdicts they back, so they stay local.
planning/*
!planning/2026-08-08-the-surface-is-three-verbs-and-a-selection/
planning/**/*.executions.json
