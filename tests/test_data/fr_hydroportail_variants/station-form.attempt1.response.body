<div class="card">
    <div class="card-header" id="headingSeries">
        <h2 class="mb-0">
            <button class="btn btn-link" data-toggle="collapse" data-target="#form-series" aria-expanded="true" aria-controls="form-series">
                Options de visualisation
            </button>
        </h2>
    </div>
    <div id="form-series" class="collapse show" aria-labelledby="headingSeries">
        <div class="card-body">
            <form name="hydro_series" method="post" novalidate="novalidate" data-entity="1232000101" data-error="Une erreur technique est survenue. Veuillez réessayer ultérieurement." data-form-error="Un ou plusieurs champs contiennent des erreurs, vérifiez votre saisie et ré-essayez.">
                        <div class="row">
                <div class="col-12 col-lg-8">
                    <p class="font-weight-bold">Visualiser les mesures :</p>
                    <div class="d-flex">
                        <div class="form-group">
                            <div class="d-flex flex-row">
                                <label class="m-0 pt-2" for="hydro_series_startAt">
        Du
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></label>
        
                                <div class="mx-2">
                                    <input type="text" id="hydro_series_startAt" name="hydro_series[startAt]" required="required" class="datepicker form-control form-control" />
                                    <small id="hydro_series_startAt_help" class="form-text text-muted">Format attendu : dd/MM/yyyy (fuseau horaire de vos préférences)</small>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="d-flex flex-row">
                                <label class="m-0 pt-2" for="hydro_series_endAt">
        Au
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></label>
        
                                <div class="mx-2">
                                    <input type="text" id="hydro_series_endAt" name="hydro_series[endAt]" required="required" class="datepicker form-control form-control" />
                                    <small id="hydro_series_endAt_help" class="form-text text-muted">Format attendu : dd/MM/yyyy (fuseau horaire de vos préférences)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="advanced-display">
                        <span class="font-weight-bold">Afficher :</span>
                                    <div class="form-group"><div class="form-check">        <input type="checkbox" id="hydro_series_threshold" name="hydro_series[threshold]" class="form-check-inline form-check-input" value="1" />
        <label class="form-check-label" for="hydro_series_threshold">Les seuils</label>
        </div></div>
                                        <div class="form-group"><div class="form-check">        <input type="checkbox" id="hydro_series_tonnage" name="hydro_series[tonnage]" class="form-check-inline form-check-input" value="1" />
        <label class="form-check-label" for="hydro_series_tonnage">Les jaugeages</label>
        </div></div>
                                        <div class="form-group"><div class="form-check">        <input type="checkbox" id="hydro_series_event" name="hydro_series[event]" class="form-check-inline form-check-input" value="1" />
        <label class="form-check-label" for="hydro_series_event">Les évènements</label>
        </div></div>
                        </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-lg-8">
                    <fieldset class="bold-legend">
                        <legend class="col-form-label d-inline w-auto float-left">
        Type de grandeur
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></legend>
        
                                                                        <div class="form-group">
                                <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_variableType_0" name="hydro_series[variableType]" required="required" class="form-check" value="simple_and_interpolated_and_hourly_variable" />
        <label for="hydro_series_variableType_0" class="form-check-label" >
            Instantané, interpolé ou horaire
        </label></div>
                                                        <div class="form-group">
                                <div class="d-flex flex-row align-items-center">
                                    <label class="m-0" for="hydro_series_simpleAndInterpolatedAndHourlyVariable">
        Grandeur
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></label>
        
                                    <div class="mx-2 flex-fill">
                                        <select id="hydro_series_simpleAndInterpolatedAndHourlyVariable" name="hydro_series[simpleAndInterpolatedAndHourlyVariable]" class="form-control"><option value="H">H - Hauteur instantanée</option><option value="Hln">Hln - Hauteurs interpolées toutes les n minutes</option><option value="Q">Q - Débit instantané</option><option value="Qln">Qln - Débits interpolés toutes les n minutes</option><option value="QmnH">QmnH - Débit moyen n horaire</option><option value="V">V - Vitesse instantanée</option></select>
                                    </div>
                                </div>
                            </div>
                                                    </div>
                                                                                            <div class="form-group">
                                <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_variableType_1" name="hydro_series[variableType]" required="required" class="form-check" value="daily_variable" />
        <label for="hydro_series_variableType_1" class="form-check-label" >
            Journalier
        </label></div>
                                                        <div class="form-group">
                                <div class="d-flex flex-row align-items-center">
                                    <label class="m-0" for="hydro_series_dailyVariable">
        Grandeur
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></label>
        
                                    <div class="mx-2 flex-fill">
                                        <select id="hydro_series_dailyVariable" name="hydro_series[dailyVariable]" class="form-control"><option value="HINnJ">HINnJ - Hauteur instantanée minimale n journalière</option><option value="HIXnJ">HIXnJ - Hauteur instantanée maximale n journalière</option><option value="QmnJ">QmnJ - Débit moyen sur n jours</option><option value="QINnJ">QINnJ - Débit instantané minimal n journalier</option><option value="QIXnJ">QIXnJ - Débit instantané maximal n journalier</option></select>
                                    </div>
                                </div>
                            </div>
                                                    </div>
                                                                                            <div class="form-group">
                                <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_variableType_2" name="hydro_series[variableType]" required="required" class="form-check" value="monthly_variable" />
        <label for="hydro_series_variableType_2" class="form-check-label" >
            Mensuel
        </label></div>
                                                        <div class="form-group">
                                <div class="d-flex flex-row align-items-center">
                                    <label class="m-0" for="hydro_series_monthlyVariable">
        Grandeur
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></label>
        
                                    <div class="mx-2 flex-fill">
                                        <select id="hydro_series_monthlyVariable" name="hydro_series[monthlyVariable]" class="form-control"><option value="HINM">HINM - Hauteur instantanée minimale mensuelle</option><option value="HIXM">HIXM - Hauteur instantanée maximale mensuelle</option><option value="QmM">QmM - Débit moyen mensuel</option><option value="QINM">QINM - Débit instantané minimal mensuel</option><option value="QIXM">QIXM - Débit instantané maximal mensuel</option></select>
                                    </div>
                                </div>
                            </div>
                                                    </div>
                    </fieldset>
                                                        </div>
            </div>
            <div class="row">
                <div class="col-12 col-lg-8">
                                <div class="form-group"><label id="stepLabel" for="hydro_series_step">
        Choisir le pas de temps
        </label>
        <input type="number" id="hydro_series_step" name="hydro_series[step]" aria-describedby="hydro_series_step_help" class="form-control form-control" /><small id="hydro_series_step_help" class="form-text text-muted">Par défaut 1 pour l&#039;élaboré, doit valoir entre 1 et 23 pour les grandeurs horaires, entre 1 et 30 pour les grandeurs journalières. Obligatoire pour l&#039;interpolé, doit être un diviseur de 60.</small></div>
    
                </div>
                <div class="col-12 col-lg-4">
                                <div class="form-group"><div class="form-check">        <input type="checkbox" id="hydro_series_rolling" name="hydro_series[rolling]" class="form-check-inline form-check-input" aria-describedby="hydro_series_rolling_help" value="1" />
        <label class="form-check-label" for="hydro_series_rolling">Glissant</label>
        </div><small id="hydro_series_rolling_help" class="form-text text-muted">Si coché, retourne une valeur par unité de temps, sinon retourne une valeur par pas de temps</small></div>
    
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="bold-legend">
                                    <fieldset class="form-group"><legend class="col-form-label d-inline w-auto float-left">
        Statut par défaut des mesures
        <abbr class="required" title="(obligatoire)" aria-hidden="true">*</abbr></legend>
        <div id="hydro_series_statusData">    <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_statusData_0" name="hydro_series[statusData]" required="required" class="form-check" value="most_valid" checked="checked" />
        <label for="hydro_series_statusData_0" class="form-check-label" >
            Données les plus valides
        </label></div>    <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_statusData_1" name="hydro_series[statusData]" required="required" class="form-check" value="validated" />
        <label for="hydro_series_statusData_1" class="form-check-label" >
            Données validées
        </label></div>    <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_statusData_2" name="hydro_series[statusData]" required="required" class="form-check" value="pre_validated_and_validated" />
        <label for="hydro_series_statusData_2" class="form-check-label" >
            Données pré-validées et validées
        </label></div>    <div class="form-check">
        <input class="form-check-input" type="radio" id="hydro_series_statusData_3" name="hydro_series[statusData]" required="required" class="form-check" value="raw" />
        <label for="hydro_series_statusData_3" class="form-check-label" >
            Données brutes
        </label></div></div></fieldset>
    
                    </div>
                </div>
            </div>
            <div class="mt-3 text-right">
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </div>
            </form>
