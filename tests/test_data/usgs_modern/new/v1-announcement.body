<!doctype html><html itemscope itemtype=http://schema.org/WebPage lang=en class=no-js><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1,shrink-to-fit=no"><script src=/blog/wdfn-viz/uswds-init.min.js></script><link rel=stylesheet href=/blog/wdfn-viz/wdfnviz-all.css><meta name=generator content="Hugo 0.145.0"><link rel="shortcut icon" href=/blog/favicons/favicon.ico><title>Announcing V1 of the WDFN APIs | Water Data Blog</title>
<meta property="og:url" content="https://waterdata.usgs.gov/blog/api-v1-release/"><meta property="og:site_name" content="Water Data Blog"><meta property="og:title" content="Announcing V1 of the WDFN APIs"><meta property="og:description" content="The new Water Data APIs provide programmatic pathways to accessing all USGS Water Data for the Nation (WDFN), providing a consistent interface for accessing all data from the National Water Information System."><meta property="og:locale" content="en"><meta property="og:type" content="article"><meta property="article:published_time" content="2026-09-04T00:00:00+00:00"><meta property="article:modified_time" content="2026-09-15T09:43:52-05:00"><meta property="article:tag" content="Water Services"><meta property="article:tag" content="API"><meta property="article:tag" content="Water Data"><meta property="article:tag" content="Water Data for the Nation"><meta property="article:tag" content="NextGen"><meta property="article:tag" content="Decommission"><meta itemprop=name content="Announcing V1 of the WDFN APIs"><meta itemprop=description content="The new Water Data APIs provide programmatic pathways to accessing all USGS Water Data for the Nation (WDFN), providing a consistent interface for accessing all data from the National Water Information System."><meta itemprop=datePublished content="2026-09-04T00:00:00+00:00"><meta itemprop=dateModified content="2026-09-15T09:43:52-05:00"><meta itemprop=wordCount content="1983"><meta itemprop=keywords content="api,peak flows,wdfn,water data for the nation,apis,water data apis,api queries,user interface for APIs"><meta name=twitter:card content="summary"><meta name=twitter:title content="Announcing V1 of the WDFN APIs"><meta name=twitter:description content="The new Water Data APIs provide programmatic pathways to accessing all USGS Water Data for the Nation (WDFN), providing a consistent interface for accessing all data from the National Water Information System."><link rel=preload href=/b