                                "description":"Water measurement or water-quality analytical method code. The method used to determine a parameter value.",
                                "nullable":true,
                                "type":"string"
                            },
                            "method_category":{
                                "description":"Code representing the method category standard.",
                                "nullable":true,
                                "type":"string"
                            },
                            "method_description":{
                                "description":"A long name that fully describes a method.",
                                "nullable":true,
                                "type":"string"
                            },
                            "method_name":{
                                "description":"A short name that partially describes a method.",
                                "nullable":true,
                                "type":"string"
                            },
                            "method_type":{
                                "description":"Method type for measured or collected data",
                                "nullable":true,
                                "type":"string"
                            }
                        },
