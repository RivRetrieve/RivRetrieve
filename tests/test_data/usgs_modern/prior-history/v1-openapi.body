                    }
                ],
                "summary":"Get Topographic codes item by id",
                "tags":[
                    "topographic-codes"
                ]
            },
            "options":{
                "description":"The code that best describes the topographic setting in which the site is located. Topographic setting refers to the geomorphic features in the vicinity of the site.\n",
