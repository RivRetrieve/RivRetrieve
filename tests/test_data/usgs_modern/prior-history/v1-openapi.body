            "CombinedMethodCitationsFeature":{
                "properties":{
                    "geometry":{
                        "nullable":true
                    },
                    "id":{
                        "type":"string"
                    },
                    "properties":{
                        "properties":{
                            "citation_description":{
                                "description":"Method citation description. Null when the method has no citation, and also when the method-citation record names a citation with no matching record in the citations reference list.",
                                "nullable":true,
                                "title":"Citation description",
                                "type":"string"
                            },
                            "citation_method_id":{
                                "description":"Citation method identification number. Null when the method has no citation, in which case the `id` ends in `.0`.",
                                "nullable":true,
                                "title":"Citation method ID",
                                "type":"integer"
                            },
                            "citation_method_number":{
                                "description":"A number assigned to a method within a cited reference.",
                                "nullable":true,
                                "title":"Citation method number",
                                "type":"string"
                            },
                            "citation_name":{
                                "description":"Method citation name \u2014 an abbreviated citation that describes the reference. Null when the method-citation record names none.",
                                "nullable":true,
                                "title":"Citation name",
                                "type":"string"
                            },
                            "id":{
                                "description":"A unique identifier for one method/citation pairing, formed as the `method_id`, a `.`, and the `citation_method_id`. A `0` in the second position means the method has no citation. Derived, so both halves are also available as their own properties.",
                                "nullable":true,
                                "title":"Combined method ID",
                                "type":"string"
                            },
                            "method_category":{
                                "description":"Code representing the method category standard.",
                                "nullable":true,
                                "title":"Method category",
                                "type":"string"
                            },
                            "method_category_description":{
                                "description":"Full description of the method category as defined by the USGS Water Mission Area standards for field and analytical methods and their fit-for-purpose use internally and for public delivery.",
                                "nullable":true,
                                "title":"Method category description",
                                "type":"string"
                            },
                            "method_category_name":{
                                "description":"Name representing the method category standard.",
                                "nullable":true,
                                "title":"Method category name",
                                "type":"string"
                            },
                            "method_description":{
                                "description":"A long name that fully describes the method.",
                                "nullable":true,
                                "title":"Method description",
                                "type":"string"
                            },
                            "method_id":{
                                "description":"The RLMS method code. Shared by every row describing the same method.",
                                "nullable":true,
                                "title":"Method ID",
                                "type":"string"
                            },
                            "method_name":{
                                "description":"A short name that partially describes the method.",
                                "nullable":true,
                                "title":"Method name",
                                "type":"string"
                            },
                            "method_source":{
                                "description":"Protocol organization code.",
                                "nullable":true,
                                "title":"Method source",
                                "type":"string"
                            },
                            "method_type":{
                                "description":"Method type for measured or collected data.",
                                "nullable":true,
                                "title":"Method type",
                                "type":"string"
                            }
                        },
                        "type":"object"
                    },
