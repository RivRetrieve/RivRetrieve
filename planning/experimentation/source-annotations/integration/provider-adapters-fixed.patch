diff --git a/src/rivretrieve/_internal/source_annotations.py b/src/rivretrieve/_internal/source_annotations.py
new file mode 100644
index 00000000..532ee7d1
--- /dev/null
+++ b/src/rivretrieve/_internal/source_annotations.py
@@ -0,0 +1,263 @@
+"""Experimental typed source-slot relations."""
+
+from dataclasses import dataclass
+
+import polars as pl
+
+from rivretrieve._internal.catalogues.schemas import CatalogueColumn, CatalogueSchema
+
+
+@dataclass(frozen=True)
+class AnnotationField:
+    source_name: str
+    meaning: str | None
+    reference: str | None
+
+
+@dataclass(frozen=True)
+class AnnotationTable:
+    schema_id: str
+    rows: pl.DataFrame
+    fields: tuple[AnnotationField, ...] = ()
+
+
+def row_schema(base, rows):
+    # Names alone permit schema inspection; validate_annotations checks declarations.
+    extra = []
+    for name in ("occurrence_id",):
+        if name in rows.columns:
+            extra.append(CatalogueColumn(name, rows.schema[name]))
+    return CatalogueSchema(base.name, base.columns + tuple(extra), base.unique_keys, base.enum_values)
+
+
+def combine_tables(tables):
+    grouped = {}
+    declarations = {}
+    for table in tables:
+        if table.schema_id in declarations and declarations[table.schema_id] != table.fields:
+            from rivretrieve._internal.issues import FatalContractError
+
+            raise FatalContractError("Conflicting annotation field definitions")
+        declarations[table.schema_id] = table.fields
+        if table.schema_id in grouped and grouped[table.schema_id][0].schema != table.rows.schema:
+            from rivretrieve._internal.issues import FatalContractError
+
+            raise FatalContractError("Conflicting annotation schema definitions")
+        grouped.setdefault(table.schema_id, []).append(table.rows)
+    return tuple(AnnotationTable(name, pl.concat(rows), declarations[name]) for name, rows in grouped.items())
+
+
+def encode_tables(tables):
+    import base64
+    from io import BytesIO
+
+    encoded = []
+    for table in tables:
+        buffer = BytesIO()
+        table.rows.write_ipc(buffer)
+        encoded.append(
+            {
+                "schema_id": table.schema_id,
+                "fields": [
+                    {"source_name": field.source_name, "meaning": field.meaning, "reference": field.reference}
+                    for field in table.fields
+                ],
+                "ipc": base64.b64encode(buffer.getvalue()).decode("ascii"),
+            }
+        )
+    return encoded
+
+
+def decode_tables(encoded):
+    import base64
+    from io import BytesIO
+
+    return tuple(
+        AnnotationTable(
+            item["schema_id"],
+            pl.read_ipc(BytesIO(base64.b64decode(item["ipc"], validate=True))),
+            tuple(AnnotationField(**field) for field in item["fields"]),
+        )
+        for item in encoded
+    )
+
+
+def validate_tables(tables, observations, series):
+    from rivretrieve._internal.catalogues.schemas import validate_catalogue
+    from rivretrieve._internal.engine import ZoneValue
+    from rivretrieve._internal.issues import FatalContractError
+
+    definitions = {item.series_id: item for item in series}
+    if not tables:
+        if "occurrence_id" in observations.columns and observations.height:
+            raise FatalContractError("Observation occurrences require annotation tables")
+        return
+    if observations.height and "occurrence_id" not in observations.columns:
+        raise FatalContractError("Annotation tables require observation occurrence identifiers")
+    indexed = {row["occurrence_id"]: row for row in observations.iter_rows(named=True)}
+    if len(indexed) != observations.height:
+        raise FatalContractError("Duplicate observation occurrence identifiers")
+    seen = set()
+    linked = set()
+    for table in tables:
+        coordinates = CatalogueSchema(
+            "SourceSlot",
+            tuple(
+                CatalogueColumn(name, dtype, nullable=name == "occurrence_id")
+                for name, dtype in {
+                    "slot_id": pl.String,
+                    "occurrence_id": pl.String,
+                    "series_id": pl.String,
+                    "facts_id": pl.String,
+                    "time": pl.Datetime("us"),
+                    "time_zone": pl.String,
+                }.items()
+            ),
+        )
+        source_columns = set(table.rows.columns) - set(coordinates.polars_schema) - {"source_call"}
+        names = [field.source_name for field in table.fields]
+        if (
+            any(not isinstance(name, str) or not name.strip() for name in names)
+            or len(set(names)) != len(names)
+            or set(names) != source_columns
+        ):
+            raise FatalContractError("Annotation field declarations must uniquely describe source columns")
+        missing = set(coordinates.polars_schema) - set(table.rows.columns)
+        if missing:
+            raise FatalContractError(f"Source slot is missing required coordinates: {sorted(missing)}")
+        validate_catalogue(table.rows.select(*coordinates.polars_schema), coordinates, on_issue="raise")
+        for row in table.rows.iter_rows(named=True):
+            try:
+                ZoneValue(row["time_zone"])
+            except (ValueError, TypeError) as error:
+                raise FatalContractError(f"Invalid source slot time zone: {error}") from error
+            if not row["slot_id"] or row["slot_id"] in seen:
+                raise FatalContractError("Duplicate or empty source slot identifier")
+            seen.add(row["slot_id"])
+            definition = definitions.get(row["series_id"])
+            if definition is None or row["facts_id"] not in {fact.facts_id for fact in definition.facts}:
+                raise FatalContractError("Source slot references unknown series or facts")
+            occurrence = row["occurrence_id"]
+            if occurrence is None:
+                continue
+            if occurrence in linked or occurrence not in indexed:
+                raise FatalContractError("Source slot occurrence link is duplicate or dangling")
+            linked.add(occurrence)
+            observation = indexed[occurrence]
+            from rivretrieve._internal.time_axis import TimeAxis, timestamp_on_axis
+
+            same_label = (row["time"], row["time_zone"]) == (observation["time"], observation["time_zone"])
+            native_utc = timestamp_on_axis(row["time"], row["time_zone"], TimeAxis.UTC)
+            observed_utc = timestamp_on_axis(observation["time"], observation["time_zone"], TimeAxis.UTC)
+            same_instant = native_utc is not None and native_utc == observed_utc
+            if any(row[name] != observation[name] for name in ("series_id", "facts_id")) or not (
+                same_label or same_instant
+            ):
+                raise FatalContractError("Source slot contradicts observation coordinates")
+    if linked != set(indexed):
+        raise FatalContractError("Observation occurrence lacks source slot")
+
+
+def select_tables(tables, observations, series, start, end):
+    from rivretrieve._internal.physical_window import native_window
+
+    definitions = {item.series_id: item for item in series}
+    occurrences = set(observations["occurrence_id"]) if "occurrence_id" in observations.columns else set()
+    selected = []
+    for table in tables:
+        keep = []
+        for row in table.rows.iter_rows(named=True):
+            definition = definitions.get(row["series_id"])
+            fact = (
+                next((fact for fact in definition.facts if fact.facts_id == row["facts_id"]), None)
+                if definition
+                else None
+            )
+            if fact is None:
+                keep.append(False)
+                continue
+            interval = native_window(start, end, fact)
+            keep.append(
+                row["occurrence_id"] in occurrences
+                if row["occurrence_id"] is not None
+                else interval.start <= row["time"] <= interval.end
+            )
+        selected.append(
+            AnnotationTable(table.schema_id, table.rows.filter(pl.Series(keep, dtype=pl.Boolean)), table.fields)
+        )
+    return tuple(selected)
+
+
+def validate_outcome_scope(tables, outcomes):
+    from rivretrieve._internal.issues import FatalContractError
+    from rivretrieve._internal.source_series import OutcomeStatus
+    from rivretrieve._internal.time_axis import timestamp_on_axis
+
+    for table in tables:
+        if (
+            "source_call" not in table.rows.columns
+            or table.rows.schema["source_call"] != pl.String
+            or table.rows["source_call"].null_count()
+        ):
+            raise FatalContractError("Source slots require source outcome scope")
+        for row in table.rows.iter_rows(named=True):
+            supported = False
+            for outcome in outcomes:
+                if (
+                    row["source_call"] not in outcome.calls
+                    or outcome.status not in (OutcomeStatus.SUCCESS, OutcomeStatus.EMPTY)
+                    or outcome.series_id != row["series_id"]
+                    or row["facts_id"] not in outcome.facts_ids
+                ):
+                    continue
+                timestamp = timestamp_on_axis(row["time"], row["time_zone"], outcome.window.axis)
+                if (
+                    outcome.coverage == "interval"
+                    and timestamp is not None
+                    and outcome.window.start <= timestamp <= outcome.window.end
+                ):
+                    supported = True
+                    break
+            if not supported:
+                raise FatalContractError("Source slot contradicts source outcome scope")
+
+
+def replace_tables(held, additions, replacements):
+    from dataclasses import replace
+
+    from rivretrieve._internal.time_axis import timestamp_on_axis
+
+    def covered(row, *, retirement):
+        for replacement in replacements:
+            coverage = replacement.coverage
+            facts = (replacement.replaced_facts_ids or coverage.facts_ids) if retirement else coverage.facts_ids
+            if row["series_id"] != coverage.series_id or row["facts_id"] not in facts:
+                continue
+            timestamp = timestamp_on_axis(row["time"], row["time_zone"], coverage.interval.axis)
+            if timestamp is not None and coverage.interval.start <= timestamp <= coverage.interval.end:
+                return True
+        return False
+
+    retained = [
+        replace(
+            table,
+            rows=table.rows.filter(
+                pl.Series(
+                    [not covered(row, retirement=True) for row in table.rows.iter_rows(named=True)], dtype=pl.Boolean
+                )
+            ),
+        )
+        for table in held
+    ]
+    admitted = [
+        replace(
+            table,
+            rows=table.rows.filter(
+                pl.Series(
+                    [covered(row, retirement=False) for row in table.rows.iter_rows(named=True)], dtype=pl.Boolean
+                )
+            ),
+        )
+        for table in additions
+    ]
+    return combine_tables((*retained, *admitted))
