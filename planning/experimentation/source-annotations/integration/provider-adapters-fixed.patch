diff --git a/tests/test_annotation_bundle_experiment.py b/tests/test_annotation_bundle_experiment.py
new file mode 100644
index 00000000..66ff8e7c
--- /dev/null
+++ b/tests/test_annotation_bundle_experiment.py
@@ -0,0 +1,108 @@
+"""Actual public view and bundle paths for synthetic annotations."""
+
+import polars.testing as pt
+import pytest
+
+import rivretrieve as rr
+from rivretrieve._internal.source_series import OutcomeStatus
+from tests.test_independent_fact_cache import _fetch, fact_cache
+from tests.test_linked_annotations_experiment import attach_slots
+
+annotation_cache = fact_cache
+
+
+@pytest.mark.parametrize("state", ["success", "unmeasured", "empty", "failed"])
+def test_real_bundle_roundtrip_preserves_slots_and_definitions(annotation_cache, state):
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    if state == "failed":
+        _fetch(selection)
+        stages.status = {"mean": OutcomeStatus.FAILED, "max": OutcomeStatus.FAILED}
+    elif state in ("empty", "unmeasured"):
+        stages.status = {"mean": OutcomeStatus.EMPTY, "max": OutcomeStatus.EMPTY}
+        stages.no_slots = state == "empty"
+    result = _fetch(selection)
+    restored = rr.from_bundle(rr.to_bundle(result))
+    pt.assert_frame_equal(restored.data, result.data)
+    assert restored.annotations[0].fields == result.annotations[0].fields
+    pt.assert_frame_equal(restored.annotations[0].rows, result.annotations[0].rows)
+    assert restored.receipts.entries == ()
+    assert restored.outcomes == result.outcomes
+
+
+def test_pick_filters_source_slot_facts_before_bundle(annotation_cache):
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    result = _fetch(selection)
+    picked = rr.pick(result, statistic="mean")
+    assert picked.annotations[0].rows["facts_id"].to_list() == ["mean", "mean"]
+    restored = rr.from_bundle(rr.to_bundle(picked))
+    pt.assert_frame_equal(restored.annotations[0].rows, picked.annotations[0].rows)
+
+
+def test_utc_keeps_native_slots_and_occurrence_links_through_bundle(annotation_cache):
+    from dataclasses import replace
+    from datetime import timedelta
+
+    import polars as pl
+
+    from tests.test_independent_fact_cache import ROW_TIME
+
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    parse = stages.parse
+
+    def offset(payload, config):
+        parsed = parse(payload, config)
+        return replace(
+            parsed,
+            rows=parsed.rows.with_columns(pl.lit("+01:00").alias("time_zone")),
+            annotations=tuple(
+                replace(table, rows=table.rows.with_columns(pl.lit("+01:00").alias("time_zone")))
+                for table in parsed.annotations
+            ),
+        )
+
+    stages.parse = offset
+    native = _fetch(selection)
+    converted = rr.to_utc(native)
+    assert converted.data["time"].to_list() == [ROW_TIME - timedelta(hours=1)] * 2
+    pt.assert_frame_equal(converted.annotations[0].rows, native.annotations[0].rows)
+    restored = rr.from_bundle(rr.to_bundle(converted))
+    pt.assert_frame_equal(restored.data, converted.data)
+    pt.assert_frame_equal(restored.annotations[0].rows, native.annotations[0].rows)
+
+
+@pytest.mark.parametrize("defect", ["link", "support"])
+def test_bundle_rejects_invalid_slot_association(annotation_cache, defect):
+    import json
+    from dataclasses import replace
+    from io import BytesIO
+    from zipfile import ZipFile
+
+    import polars as pl
+
+    from rivretrieve._internal.issues import FatalContractError
+    from rivretrieve._internal.source_annotations import decode_tables, encode_tables
+
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    result = _fetch(selection)
+    content = rr.to_bundle(result)
+    with ZipFile(BytesIO(content)) as source:
+        files = {name: source.read(name) for name in source.namelist()}
+    manifest = json.loads(files["manifest.json"])
+    tables = decode_tables(manifest["annotations"])
+    rows = tables[0].rows.with_columns(
+        pl.when(pl.col("occurrence_id").is_not_null()).then(pl.lit("dangling")).otherwise(None).alias("occurrence_id")
+    )
+    if defect == "support":
+        rows = tables[0].rows.with_columns(pl.lit("unrecorded-call").alias("source_call"))
+    manifest["annotations"] = encode_tables((replace(tables[0], rows=rows),))
+    files["manifest.json"] = json.dumps(manifest).encode()
+    output = BytesIO()
+    with ZipFile(output, "w") as target:
+        for name, data in files.items():
+            target.writestr(name, data)
+    with pytest.raises(FatalContractError, match="dangling" if defect == "link" else "outcome scope"):
+        rr.from_bundle(output.getvalue())
