+def test_slot_identity_and_scope_validation():
+    import pytest
+
+    from rivretrieve._internal.issues import FatalContractError
+    from rivretrieve._internal.source_annotations import select_tables, validate_tables
+    from tests.test_fetch import _test_definition
+
+    definition = _test_definition("synthetic", "a", "level")
+    slots = pl.DataFrame(
+        {
+            "slot_id": ["a", "b"],
+            "occurrence_id": [None, None],
+            "series_id": [definition.series_id] * 2,
+            "facts_id": [definition.facts[0].facts_id] * 2,
+            "time": [ROW_TIME, ROW_TIME + timedelta(hours=1)],
+            "time_zone": ["unknown"] * 2,
+        },
+        schema_overrides={"occurrence_id": pl.String},
+    )
+    empty = pl.DataFrame(schema={"occurrence_id": pl.String})
+    table = AnnotationTable("synthetic:slots", slots)
+    validate_tables((table,), empty, (definition,))
+    selected = select_tables((table,), empty, (definition,), ROW_TIME, ROW_TIME)
+    assert selected[0].rows["slot_id"].to_list() == ["a"]
+    for bad, message in (
+        (slots.with_columns(pl.lit("same").alias("slot_id")), "Duplicate"),
+        (slots.with_columns(pl.lit("bad").alias("series_id")), "unknown"),
+        (slots.with_columns(pl.lit("bad").alias("facts_id")), "unknown"),
+    ):
+        with pytest.raises(FatalContractError, match=message):
+            validate_tables((AnnotationTable("synthetic:slots", bad),), empty, (definition,))
+
