+def attach_slots(stages):
+    parse = stages.parse
+
+    def annotated(payload, config):
+        parsed = parse(payload, config)
+        occurrence = payload.acquisition_id + ":0"
+        rows = parsed.rows.with_columns(pl.lit(occurrence).alias("occurrence_id"))
+        slots = pl.DataFrame(
+            {
+                "slot_id": [occurrence, payload.acquisition_id + ":1"],
+                "occurrence_id": [occurrence, None],
+                "series_id": [stages.definition.series_id] * 2,
+                "facts_id": [payload.content.decode()] * 2,
+                "time": [ROW_TIME, ROW_TIME + timedelta(hours=1)],
+                "time_zone": ["+00:00"] * 2,
+                "marker": [getattr(stages, "marker", " "), "$"],
+                "source_call": [payload.acquisition_id] * 2,
+            },
+            schema_overrides={"time": pl.Datetime("us")},
+        )
+        from rivretrieve._internal.source_series import OutcomeStatus
+
+        if parsed.outcomes[0].status is OutcomeStatus.EMPTY:
+            slots = (
+                slots.clear() if getattr(stages, "no_slots", False) else slots.filter(pl.col("occurrence_id").is_null())
+            )
+        elif parsed.outcomes[0].status is OutcomeStatus.FAILED:
+            slots = slots.clear()
+        return replace(
+            parsed,
+            rows=rows,
+            annotations=(AnnotationTable("synthetic:slot-markers", slots, (AnnotationField("marker", None, None),)),),
+        )
+
+    stages.parse = annotated
+
