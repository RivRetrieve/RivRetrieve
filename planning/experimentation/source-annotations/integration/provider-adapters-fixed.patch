+def test_measured_and_unmeasured_slots_survive_actual_reuse(annotation_cache):
+    stages, selection, root = annotation_cache
+    attach_slots(stages)
+    fresh = _fetch(selection)
+    tables = fresh.annotations
+    assert len(tables) == 1
+    assert fresh.data.height == 2  # missing slots never become null measurements
+    assert tables[0].rows.sort("slot_id").select("slot_id", "occurrence_id", "facts_id", "time", "marker").rows() == [
+        ("1-max:0", "1-max:0", "max", ROW_TIME, " "),
+        ("1-max:1", None, "max", ROW_TIME + timedelta(hours=1), "$"),
+        ("1-mean:0", "1-mean:0", "mean", ROW_TIME, " "),
+        ("1-mean:1", None, "mean", ROW_TIME + timedelta(hours=1), "$"),
+    ]
+    stages.forbid_fetch = True
+    reused = _fetch(selection, cache="reuse")
+    pt.assert_frame_equal(fresh.data, reused.data)
+    pt.assert_frame_equal(tables[0].rows, reused.annotations[0].rows)
+    assert fresh.receipts.entries == reused.receipts.entries == ()
+    assert all(item.retrieved_at == OLD for item in reused.outcomes)
+    import json
+    from time import perf_counter
+
+    from rivretrieve._internal.source_annotations import decode_tables, encode_tables
+
+    manifest_path = root / stages.provider_id / "store" / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    started = perf_counter()
+    for _ in range(100):
+        decoded = decode_tables(manifest["annotations"])
+    decode_ms = (perf_counter() - started) * 10
+    started = perf_counter()
+    for _ in range(100):
+        encoded = encode_tables(tables)
+    encode_ms = (perf_counter() - started) * 10
+    pt.assert_frame_equal(decoded[0].rows, tables[0].rows)
+    assert encoded == manifest["annotations"]
+    print(
+        f"slots=4 measured=2 manifest_bytes={manifest_path.stat().st_size} annotation_json_bytes={len(json.dumps(encoded).encode())} warm_decode_mean_ms={decode_ms:.4f} encode_mean_ms={encode_ms:.4f}"
+    )
+    import rivretrieve as rr
+
+    narrow = rr.fetch(
+        selection, start="2026-01-01T12:00:00", end="2026-01-01T12:00:00", cache="reuse", on_issue="ignore"
+    )
+    assert narrow.annotations[0].rows["slot_id"].to_list() == ["1-mean:0", "1-max:0"]
+
