+"""Invented MLIT hourly DAT; never a retained publisher response."""
+
+from dataclasses import replace
+from datetime import datetime
+
+import polars as pl
+
+from rivretrieve._internal.engine import SourceCoordinates
+from rivretrieve._internal.primitives import ProductId
+from rivretrieve._internal.providers.jp_mlit.config import config
+from rivretrieve._internal.providers.jp_mlit.fetch import JpMlitPayloadCoordinates
+from rivretrieve._internal.providers.jp_mlit.parse import parse
+from tests.test_usgs_modern_parse import payload
+
+
+def test_missing_numeric_slot_and_raw_marker_preserved_without_measurement():
+    header = "," + ",".join(cell for hour in range(1, 25) for cell in (f"{hour}時", ""))
+    cells = ["2024/01/01"] + [cell for hour in range(1, 25) for cell in ("123", " $ " if hour == 2 else " ")]
+    lines = [
+        "時刻水位月表検索結果",
+        "水系名,synthetic",
+        "河川名,synthetic",
+        "観測所名,synthetic",
+        "観測所記号,synthetic",
+        "",
+        "#  フラグの意味： *:暫定値, $:欠測, #:閉局, -:未登録",
+        "",
+        header,
+        ",".join(cells),
+    ]
+    request = replace(
+        payload({}),
+        source_coordinates=SourceCoordinates(JpMlitPayloadCoordinates(2, "dat")),
+        station_products=(("synthetic", ProductId("stage_hourly")),),
+        content="\n".join(lines).encode("shift_jis"),
+        acquisition_id="mlit-authored",
+    )
+    result = parse(request, config())
+    assert result.rows.height == 23
+    slots = result.annotations[0].rows
+    assert slots.height == 24
+    assert slots["marker"].to_list() == [" ", " $ "] + [" "] * 22
+    missing = slots.filter(pl.col("occurrence_id").is_null())
+    assert missing.select("time", "source_label", "pair_index").rows() == [
+        (datetime(2024, 1, 1, 2), "2024/01/01 2時", 2)
+    ]
+    assert slots[-1, "time"] == datetime(2024, 1, 2)
+    assert slots[-1, "source_label"] == "2024/01/01 24時"
