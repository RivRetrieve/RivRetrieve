+    outcome, _ = _success("series", "answer", [], day=1)
+    outcome = outcome.model_copy(
+        update={
+            "calls": ("source-a",),
+            "facts_ids": ("fact",),
+            "window": outcome.window.model_copy(update={"start": ROW_TIME, "end": ROW_TIME + timedelta(hours=1)}),
