+"""Real replacement of source slots using existing successful coverage."""
+
+import pytest
+
+from rivretrieve._internal.source_series import OutcomeStatus
+from tests.test_independent_fact_cache import NEW, _fetch, fact_cache
+from tests.test_linked_annotations_experiment import attach_slots
+
+annotation_cache = fact_cache
+
+
+@pytest.mark.parametrize("mode", ["success", "empty", "empty_without_slots", "failed", "partial"])
+def test_refresh_keeps_source_slots_with_their_acquisition(annotation_cache, mode):
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    first = _fetch(selection)
+    stages.marker = "changed"
+    stages.stamps = {"mean": NEW, "max": NEW}
+    if mode in ("empty", "empty_without_slots"):
+        stages.no_slots = mode == "empty_without_slots"
+        stages.status = {"mean": OutcomeStatus.EMPTY, "max": OutcomeStatus.EMPTY}
+    elif mode == "failed":
+        stages.status = {"mean": OutcomeStatus.FAILED, "max": OutcomeStatus.FAILED}
+    elif mode == "partial":
+        stages.status["max"] = OutcomeStatus.FAILED
+    result = _fetch(selection)
+    slots = result.annotations[0].rows.sort("slot_id")
+    if mode == "failed":
+        assert slots["slot_id"].to_list() == ["1-max:0", "1-max:1", "1-mean:0", "1-mean:1"]
+        assert slots["source_call"].to_list() == ["1-max", "1-max", "1-mean", "1-mean"]
+    elif mode == "empty_without_slots":
+        assert result.data.is_empty()
+        assert slots.is_empty()
+    elif mode == "empty":
+        assert result.data.is_empty()
+        assert slots["slot_id"].to_list() == ["2-max:1", "2-mean:1"]
+        assert slots["occurrence_id"].null_count() == 2
+    elif mode == "partial":
+        assert slots["slot_id"].to_list() == ["1-max:0", "1-max:1", "2-mean:0", "2-mean:1"]
+        assert slots["marker"].to_list() == [" ", "$", "changed", "$"]
+    else:
+        assert slots["slot_id"].to_list() == ["2-max:0", "2-max:1", "2-mean:0", "2-mean:1"]
+        assert result.data["value"].to_list() == first.data["value"].to_list()
+    assert result.annotations[0].fields == first.annotations[0].fields
+    stages.forbid_fetch = True
+    cached = _fetch(selection, cache="reuse")
+    assert cached.annotations[0].rows.sort("slot_id").rows() == slots.rows()
+
+
+def test_overlapping_failed_fact_window_keeps_held_unmeasured_slot(annotation_cache):
+    from dataclasses import replace
+    from datetime import timedelta
+
+    import polars as pl
+
+    from tests.test_independent_fact_cache import ROW_TIME
+
+    stages, selection, _ = annotation_cache
+    attach_slots(stages)
+    _fetch(selection)
+    parse = stages.parse
+
+    def overlapping(payload, config):
+        parsed = parse(payload, config)
+        if payload.content == b"max":
+            failure = parsed.outcomes[0].model_copy(
+                update={
+                    "outcome_id": "overlap-failure",
+                    "facts_ids": ("mean",),
+                    "status": OutcomeStatus.FAILED,
+                    "reason": "synthetic overlap",
+                    "window": parsed.outcomes[0].window.model_copy(
+                        update={"start": ROW_TIME + timedelta(hours=1), "end": ROW_TIME + timedelta(hours=1)}
+                    ),
+                }
+            )
+            return replace(parsed, outcomes=(*parsed.outcomes, failure))
+        return parsed
+
+    stages.parse = overlapping
+    result = _fetch(selection)
+    mean = result.annotations[0].rows.filter(pl.col("facts_id") == "mean").sort("slot_id")
+    assert mean["slot_id"].to_list() == ["1-mean:1", "2-mean:0"]
