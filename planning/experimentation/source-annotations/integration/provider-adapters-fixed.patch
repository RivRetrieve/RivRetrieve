+    table = AnnotationTable("synthetic:slot", rows)
+    validate_outcome_scope((table,), (outcome, outcome.model_copy(update={"outcome_id": "corroborating"})))
+    for unsupported in (
+        outcome.model_copy(update={"status": OutcomeStatus.FAILED}),
+        outcome.model_copy(update={"calls": ("different-source",)}),
+        outcome.model_copy(
+            update={"window": outcome.window.model_copy(update={"start": ROW_TIME + timedelta(minutes=1)})}
+        ),
+    ):
+        with pytest.raises(FatalContractError, match="outcome scope"):
