+                    : rows.height
+                ],
+                dtype=pl.Struct({"flag": pl.Struct({"present": pl.Boolean, "value": pl.String})}),
+            ),
+        )
+        return replace(parsed, rows=rows)
+
+    stages.parse = annotated
+
