@@ -0,0 +1,152 @@
+"""Synthetic real-driver experiment. Not publisher evidence."""
+
+from dataclasses import replace
+
+import polars as pl
+import polars.testing as pt
+import pytest
+
+from rivretrieve._internal.issues import FatalContractError
+from rivretrieve._internal.source_annotations import AnnotationField
+from tests.test_independent_fact_cache import _fetch, _saved, fact_cache
+
+annotation_cache = fact_cache
+
+
+def attach(stages):
+    stages.definition = stages.definition.model_copy(
+        update={"annotation_fields": (AnnotationField(source_name="flag", native_type="string"),)}
+    )
+    parse = stages.parse
+
+    def annotated(payload, config):
+        parsed = parse(payload, config)
+        rows = pl.concat([parsed.rows, parsed.rows])
+        rows = rows.with_columns(
+            pl.Series(
+                "occurrence_id",
+                [payload.acquisition_id + ":0", payload.acquisition_id + ":1"][: rows.height],
