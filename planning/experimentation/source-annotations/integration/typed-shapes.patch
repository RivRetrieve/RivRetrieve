+"""Provider-shaped synthetic controls, not observations from those providers."""
+
+from dataclasses import replace
+
+import polars as pl
+import polars.testing as pt
+import pytest
+
+from rivretrieve._internal.source_annotations import AnnotationField
+from tests.test_independent_fact_cache import _fetch, _saved, fact_cache
+
+annotation_cache = fact_cache
+
+USGS_FIELDS = (
+    AnnotationField(source_name="approval_status", native_type="string"),
+    AnnotationField(source_name="qualifier", native_type="string_or_list"),
+)
+NVE_FIELDS = (
+    AnnotationField(source_name="quality", native_type="integer"),
+    AnnotationField(source_name="correction", native_type="integer"),
+)
+VARIANT = pl.Struct({"kind": pl.String, "string": pl.String, "strings": pl.List(pl.String)})
+USGS_TYPE = pl.Struct(
+    {
+        "approval_status": pl.Struct({"present": pl.Boolean, "value": pl.String}),
+        "qualifier": pl.Struct({"present": pl.Boolean, "value": VARIANT}),
+    }
+)
+NVE_TYPE = pl.Struct(
+    {name: pl.Struct({"present": pl.Boolean, "value": pl.Int64}) for name in ("quality", "correction")}
+)
+
+
+def typed_stages(stages):
+    parse = stages.parse
+
+    def annotated(payload, config):
+        parsed = parse(payload, config)
+        is_usgs = payload.content == b"mean"
+        old = parsed.series[0]
+        sid = old.series_id + (":strings" if is_usgs else ":integers")
+        cells = (
+            [
+                {
+                    "approval_status": {"present": True, "value": "Approved"},
+                    "qualifier": {"present": True, "value": {"kind": "string", "string": "ESTIMATED", "strings": None}},
+                },
+                {
+                    "approval_status": {"present": True, "value": "Approved"},
+                    "qualifier": {"present": True, "value": {"kind": "list", "string": None, "strings": ["ESTIMATED"]}},
+                },
+                {"approval_status": {"present": False, "value": None}, "qualifier": {"present": True, "value": None}},
+                {"approval_status": {"present": True, "value": None}, "qualifier": {"present": False, "value": None}},
+            ]
+            if is_usgs
+            else [
+                {"quality": {"present": True, "value": 2}, "correction": {"present": True, "value": 0}},
+                {"quality": {"present": True, "value": 1}, "correction": {"present": True, "value": 3}},
+            ]
+        )
+        rows = pl.concat([parsed.rows] * len(cells)).with_columns(
+            pl.lit(sid).alias("series_id"),
+            pl.Series("value", [10.0, 10.0, None, 12.0] if is_usgs else [20.0, 21.0]),
+            pl.Series("occurrence_id", [payload.acquisition_id + f":{i}" for i in range(len(cells))]),
+            pl.Series("source_annotations", cells, dtype=USGS_TYPE if is_usgs else NVE_TYPE),
+        )
+        outcomes = tuple(outcome.model_copy(update={"series_id": sid}) for outcome in parsed.outcomes)
+        inventories = tuple(
+            item.model_copy(
+                update={
+                    "members": (old.series_id + ":strings", old.series_id + ":integers"),
+                    "member_facts": ((old.series_id + ":strings", ("mean",)), (old.series_id + ":integers", ("max",))),
+                }
+            )
+            for item in parsed.inventories
+        )
+        return replace(
+            parsed,
+            rows=rows,
+            series=tuple(
+                old.model_copy(update={"series_id": old.series_id + suffix, "annotation_fields": fields})
+                for suffix, fields in ((":strings", USGS_FIELDS), (":integers", NVE_FIELDS))
+            ),
+            outcomes=outcomes,
+            inventories=inventories,
+        )
+
+    stages.parse = annotated
+
+
+def test_distinct_typed_series_keep_association_on_real_reuse(annotation_cache):
+    stages, selection, root = annotation_cache
+    typed_stages(stages)
+    fresh = _fetch(selection)
+    # Independent complete coordinate oracle, not a value multiset.
+    from tests.test_independent_fact_cache import ROW_TIME
+
+    base = stages.definition.series_id
+    assert fresh.data.select("occurrence_id", "series_id", "facts_id", "time", "value").sort(
+        "occurrence_id"
+    ).rows() == [
+        ("1-max:0", base + ":integers", "max", ROW_TIME, 20.0),
+        ("1-max:1", base + ":integers", "max", ROW_TIME, 21.0),
+        ("1-mean:0", base + ":strings", "mean", ROW_TIME, 10.0),
+        ("1-mean:1", base + ":strings", "mean", ROW_TIME, 10.0),
+        ("1-mean:2", base + ":strings", "mean", ROW_TIME, None),
+        ("1-mean:3", base + ":strings", "mean", ROW_TIME, 12.0),
+    ]
+    cells = fresh.data.sort("occurrence_id")["source_annotations"].to_list()
+    assert cells[0]["quality"] == {"present": True, "value": 2}
+    assert cells[0]["qualifier"] is None  # undeclared for this series, not an absent source field
+    assert cells[2]["qualifier"]["value"] == {"kind": "string", "string": "ESTIMATED", "strings": None}
+    assert cells[3]["qualifier"]["value"] == {"kind": "list", "string": None, "strings": ["ESTIMATED"]}
+    assert cells[4]["qualifier"] == {"present": True, "value": None}
+    assert cells[5]["qualifier"] == {"present": False, "value": None}
+    stages.forbid_fetch = True
+    reused = _fetch(selection, cache="reuse")
+    pt.assert_frame_equal(fresh.data.sort("occurrence_id"), reused.data.sort("occurrence_id"))
+    pt.assert_series_equal(
+        _saved(root).sort("occurrence_id")["source_annotations"], fresh.data.sort("occurrence_id")["source_annotations"]
+    )
+
