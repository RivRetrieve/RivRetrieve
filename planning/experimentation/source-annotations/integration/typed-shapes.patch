diff --git a/src/rivretrieve/_internal/source_annotations.py b/src/rivretrieve/_internal/source_annotations.py
new file mode 100644
index 00000000..14bfed0d
--- /dev/null
+++ b/src/rivretrieve/_internal/source_annotations.py
@@ -0,0 +1,133 @@
+"""Typed publisher field declarations and row-local annotation contracts."""
+
+from typing import Literal
+
+import polars as pl
+from pydantic import BaseModel, ConfigDict
+
+from rivretrieve._internal.catalogues.schemas import CatalogueColumn, CatalogueSchema
+from rivretrieve._internal.issues import FatalContractError
+
+
+class AnnotationField(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+    source_name: str
+    native_type: Literal["string", "integer", "string_or_list"]
+    meaning: str | None = None
+    reference: str | None = None
+
+
+def native_dtype(kind):
+    return {
+        "string": pl.String,
+        "integer": pl.Int64,
+        "string_or_list": pl.Struct({"kind": pl.String, "string": pl.String, "strings": pl.List(pl.String)}),
+    }[kind]
+
+
+def annotation_dtype(fields):
+    return pl.Struct(
+        {
+            field.source_name: pl.Struct({"present": pl.Boolean, "value": native_dtype(field.native_type)})
+            for field in fields
+        }
+    )
+
+
+def merge_fields(held, additions):
+    fields = {field.source_name: field for field in held}
+    for field in additions:
+        if field.source_name in fields and fields[field.source_name] != field:
+            raise FatalContractError("Annotation field definition changed")
+        fields[field.source_name] = field
+    return tuple(fields.values())
+
+
+def row_schema(base, rows):
+    # Names alone permit schema inspection; validate_annotations checks declarations.
+    extra = []
+    for name in ("occurrence_id", "source_annotations"):
+        if name in rows.columns:
+            extra.append(CatalogueColumn(name, rows.schema[name]))
+    return CatalogueSchema(base.name, base.columns + tuple(extra), base.unique_keys, base.enum_values)
+
+
+def validate_annotations(rows, series):
+    declarations = {item.series_id: item.annotation_fields for item in series}
+    fields = [fields for fields in declarations.values() if fields]
+    has_columns = bool({"occurrence_id", "source_annotations"} & set(rows.columns))
+    if not fields and not has_columns:
+        return
+    if {"occurrence_id", "source_annotations"} - set(rows.columns):
+        raise FatalContractError("Declared annotations require occurrence and annotation columns")
+    if (
+        rows.schema["occurrence_id"] != pl.String
+        or rows["occurrence_id"].null_count()
+        or rows["occurrence_id"].n_unique() != rows.height
+    ):
+        raise FatalContractError("Annotation occurrence identifiers must be unique non-null strings")
+    if not fields:
+        raise FatalContractError("Annotation dtype does not match field declarations")
+    actual = {field.name: field.dtype for field in rows.schema["source_annotations"].fields}
+    required = [declarations[sid] for sid in rows["series_id"].unique() if sid in declarations]
+    for declaration in required:
+        for field in annotation_dtype(declaration).fields:
+            if actual.get(field.name) != field.dtype:
+                raise FatalContractError("Annotation dtype does not match field declarations")
+    for row in rows.iter_rows(named=True):
+        if row["series_id"] not in declarations:
+            raise FatalContractError("Annotation row references an unknown source series")
+        if not declarations[row["series_id"]] or row["source_annotations"] is None:
+            raise FatalContractError("Annotation row lacks declared source fields")
+        declared = {field.source_name: field for field in declarations[row["series_id"]]}
+        for name, cell in row["source_annotations"].items():
+            if name not in declared:
+                if cell is not None:
+                    raise FatalContractError("Undeclared source field has a value")
+                continue
+            if cell is None or cell["present"] is None or (not cell["present"] and cell["value"] is not None):
+                raise FatalContractError("Annotation field presence is invalid")
+            value = cell["value"]
+            if declared[name].native_type == "string_or_list" and value is not None:
+                scalar = value["kind"] == "string" and value["string"] is not None and value["strings"] is None
+                array = (
+                    value["kind"] == "list"
+                    and value["string"] is None
+                    and value["strings"] is not None
+                    and all(item is not None for item in value["strings"])
+                )
+                if not (scalar or array):
+                    raise FatalContractError("Annotation scalar/list tag contradicts its native value")
+
+
+def align_annotations(frames):
+    """Align only declared typed struct fields; never relax native value dtypes."""
+    fields = {}
+    for frame in frames:
+        if "source_annotations" in frame.columns:
+            for field in frame.schema["source_annotations"].fields:
+                if field.name in fields and fields[field.name] != field.dtype:
+                    raise FatalContractError("Conflicting annotation field dtypes")
+                fields[field.name] = field.dtype
+    if not fields:
+        return frames
+    output = []
+    for frame in frames:
+        if "source_annotations" not in frame.columns:
+            if frame.height:
+                raise FatalContractError("Mixed annotated and undeclared rows need explicit occurrence identities")
+            continue
+        present = {field.name for field in frame.schema["source_annotations"].fields}
+        output.append(
+            frame.with_columns(
+                pl.struct(
+                    [
+                        pl.col("source_annotations").struct.field(name)
+                        if name in present
+                        else pl.lit(None, dtype=dtype).alias(name)
+                        for name, dtype in fields.items()
+                    ]
+                ).alias("source_annotations")
+            )
+        )
+    return output
